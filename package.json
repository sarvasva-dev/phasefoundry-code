{
  "name": "phasefoundry-code",
  "private": true,
  "version": "1.19.2",
  "type": "module",
  "license": "MIT",
  "homepage": "https://phasefoundry.sarthakml.in",
  "author": {
    "name": "PhaseFoundry",
    "email": "contact@sarthakml.in"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@zip.js/zip.js": "2.7.62",
    "effect": "4.0.0-beta.83",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "electron-window-state": "^5.0.3",
    "drizzle-orm": "1.0.0-rc.2"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.12",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1"
  },
  "desktopName": "phasefoundry-code.desktop",
  "productName": "PhaseFoundry Code",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "42.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.phasefoundry.code",
    "productName": "PhaseFoundry Code",
    "copyright": "Copyright \u00a9 2026 PhaseFoundry",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PhaseFoundry Code",
      "artifactName": "PhaseFoundry-Code-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PhaseFoundry-Code-Portable-${version}.${ext}"
    }
  }
}